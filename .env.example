# Keep the real values only in the hosting environment, never in Git.
AUTH_USERNAME=owner
# Generated by scripts/create-password-hash.mjs; this is a placeholder, not a valid hash.
AUTH_PASSWORD_HASH=pbkdf2-sha256$210000$base64url-salt$base64url-digest
# At least 32 random characters. Use a different value for every environment.
SESSION_SECRET=replace-with-a-long-random-secret
# Needed only when importing a private Google Sheet in the browser.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
