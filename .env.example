# Keep the real values only in the hosting environment, never in Git.
AUTH_USERNAME=owner
# HMAC hash of the password. Keep the separate pepper secret outside Git.
AUTH_PASSWORD_HASH=hmac-sha256$base64url-digest
AUTH_PASSWORD_PEPPER=replace-with-a-unique-random-secret
# At least 32 random characters. Use a different value for every environment.
SESSION_SECRET=replace-with-a-long-random-secret
# Needed only when importing a private Google Sheet in the browser.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# Server-only integrations. Store the real values as hosting secrets.
MYSKLAD_ACCESS_TOKEN=replace-with-a-moysklad-token
MYSKLAD_WEBHOOK_SECRET=replace-with-a-long-random-secret
TELEGRAM_BOT_TOKEN=replace-with-your-existing-bot-token
TELEGRAM_CHAT_ID=replace-with-your-existing-chat-id
